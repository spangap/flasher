# flashmon is a generic installer (it lives in spangap's account); a deployment
# brands it and lists its images by supplying its OWN builds.yaml, which lives
# in the untracked builds/ tree beside the workspace's straddles and is never
# committed here. Any config yaml that turns up in this repo is ignored — copy
# builds.yaml.example into <workspace>/builds/<catalogue>/builds.yaml and edit
# it there. (The CI workflow is .yml, so it stays tracked.)
*.yaml

# Generated per-deployment artifacts: the branded standalone script and its
# self-contained offline bundle(s) (made by `flashmon.py make-zip`).
flashmon/*-flashmon
flashmon/*.zip

# The served download page + bundled installer zip (`make-zip` rebuilds this dir
# each run, swapping it in wholesale, so only the latest bundle is ever kept).
flashmon/offline-installer/
flashmon/offline-installer.new/

# Python bytecode cache from running flashmon.py.
__pycache__/
